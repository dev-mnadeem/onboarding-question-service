# Copy to .env. Every value here is a default that already works, so the
# only line you must change for a real deployment is SECRET_KEY.

# --- Django ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
# Required outside development; a throwaway key is used when it is unset.
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# Leave DB_ENGINE unset for SQLite (db.sqlite3 next to manage.py).
# For the MySQL service in docker-compose.yml:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=limitless
# DB_USER=limitless
# DB_PASSWORD=limitless
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- API ------------------------------------------------------------------
API_PAGE_SIZE=25
MAX_UPLOAD_SIZE_MB=10
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=1
JWT_AUTH_HEADER_TYPE=Bearer

# --- Frontend and CORS ----------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Defaults to FRONTEND_URL. Comma-separated, scheme included.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email ----------------------------------------------------------------
# Development writes invites to the console. Set EMAIL_HOST etc. for SMTP.
DEFAULT_FROM_EMAIL=onboarding@limitless-horizon.test

# --- Uploads --------------------------------------------------------------
# MEDIA_ROOT=./media
# Any Django storage backend, e.g. storages.backends.s3.S3Storage
# FILE_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage

# --- Review assistant -----------------------------------------------------
# "rules" (default, deterministic, no network) or "anthropic".
REVIEW_ASSISTANT_PROVIDER=rules
REVIEW_ASSISTANT_THIN_ANSWER_CHARS=15
# ANTHROPIC_API_KEY=
# REVIEW_ASSISTANT_MODEL=claude-sonnet-4-5
